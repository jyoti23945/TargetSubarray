#include<bits/stdc++.h>
using namespace std;
string word(string s){
    int n=s.size();
    for(int i=0;i<n;i++){
        if(i==0||i==n-1)
        s[i]=toupper(s[i]);
        else if(s[i]==' '){
            if(i-1>=0)
            s[i-1]=toupper(s[i-1]);
            if(i+1<n)
            s[i+1]=toupper(s[i+1]);
        }
    }
    return s;
}
int main(){
    string t="Take u Forward is Awesome";
    cout<<word(t);

}
