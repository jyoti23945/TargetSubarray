#include<bits/stdc++.h>
using namespace std;
int solve(string str, int length){
int vowels=0;
int consonants=0;
int spaces=0;
for(auto s:str){
    s=tolower(s);
}
for(int i=0;i<str.size();i++){
    if(str[i]=='a'||str[i]='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'){
        vowels++;
    }
    else if(str[i]==' ')
    spaces++;
    else if(str[i]>='a'&&str[i]<='z')
    consonants++;

}
cout<<"vowels: "<<vowels<<"\n";
cout<<"consonants: "<<consonants<<"\n";
cout<<"white spaces"<<spaces<<"\n"
}
int main(){
    string str="take you forward";
    int length=str.length();
    solve(str,length);
    return 0;
}
