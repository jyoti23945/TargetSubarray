#include<bits/stdc++.h>
using namespace std;
int main(){
  cout<<"Enter your string";
  string s;
  cin>>s;
  int sum=0;
  string temp="";
  for(int i=0;i<s.size();i++){
    if(isdigit(s[i])){
        temp+=s[i];
    }
    else{
        if(!temp.empty()){
            sum+=stoi(temp);
            temp="";
        }

    }
  }
  if(!temp.empty())
  sum+=stoi(temp);
  cout<<sum;
  return 0;
}
